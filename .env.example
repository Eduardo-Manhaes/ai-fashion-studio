# ===== REDIS (Job Queue System) =====
# Sistema detecta automaticamente Redis via REDIS_URL
# Se REDIS_URL NÃO estiver configurado → usa MockQueue (desenvolvimento, inline processing)
# Se REDIS_URL estiver configurado → usa BullMQ (produção, workers separados)

# Upstash Redis (gratuito): https://console.upstash.com/
# REDIS_URL=rediss://default:password@endpoint.upstash.io:6379

# ===== APIs de IA =====
# FASHN.ai API (geração de fotos)
FASHN_API_KEY=

# Fal.ai (Kling + Veo 3)
FAL_API_KEY=

# OpenAI (GPT Image 2 para fotos V3)
OPENAI_API_KEY=

# Google AI Studio (deprecated - Veo 3 migrado para Fal.ai)
# GOOGLE_AI_KEY=

# ===== Server =====
PORT=3000
NODE_ENV=development

# ===== Supabase =====
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Stripe — modo TEST =====
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Stripe Price IDs — planos de assinatura
# Criar produtos no Dashboard: https://dashboard.stripe.com/test/products
# Básico: R$ 35/mês (20 créditos) — ~10 fotos ou 2 vídeos
# Starter: R$ 79/mês (50 créditos) — ~25 fotos ou 6 vídeos
# Pro: R$ 159/mês (120 créditos) — ~60 fotos ou 15 vídeos
STRIPE_PRICE_BASICO=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# ===== SEGURANÇA =====
# Origens permitidas para CORS (separadas por vírgula)
# Produção: adicione seu domínio (ex: https://modelofacil.ia.br)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== CUSTOS DE GERAÇÃO (informativo) =====
# Foto: 2 créditos
# Vídeo movimento (Kling): 8 créditos
# Vídeo falando (Veo 3.1): 15 créditos
