# ===== REDIS (Job Queue System) =====
# FASE 3: Sistema detecta automaticamente Redis via REDIS_URL
# Se REDIS_URL NÃO estiver configurado → usa MockQueue (desenvolvimento, inline processing)
# Se REDIS_URL estiver configurado → usa BullMQ (produção, workers separados)

# IMPORTANTE: Mantenha estas linhas COMENTADAS em desenvolvimento!
# Descomente APENAS quando tiver Redis rodando de verdade.

# Opção 1: URL completa (recomendado para Upstash/Redis Cloud)
# REDIS_URL=rediss://default:password@endpoint.upstash.io:6379

# Opção 2: Componentes separados (localhost ou Redis tradicional)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false  # Set true para Upstash/Redis Cloud

# Upstash (grátis): https://console.upstash.com/ → Create Database → Copy URL

# ===== APIs =====
# FASHN.ai API
FASHN_API_KEY=

# Fal.ai (Kling + Veo 3)
FAL_API_KEY=

# OpenAI (para GPT Image 2)
OPENAI_API_KEY=

# Google AI Studio — NÃO MAIS USADO (Veo 3 migrado para Fal.ai)
# GOOGLE_AI_KEY=

# Server
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — modo TEST (trocar para LIVE quando for pra produção)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs — preencher após criar os produtos no painel do Stripe
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_ENTERPRISE=

# Stripe Price IDs — pacotes de créditos avulsos
STRIPE_PRICE_PACK_50=
STRIPE_PRICE_PACK_200=
STRIPE_PRICE_PACK_500=

# ===== SEGURANÇA (FASE 2) =====
# Origens permitidas para CORS (separadas por vírgula)
# Produção: adicione seu domínio aqui (ex: https://modelofacil.com.br)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
